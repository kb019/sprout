#!/bin/sh
commit_msg=$(cat "$1")
pattern='^(feat|fix|docs|style|refactor|perf|test|chore|build|ci|revert)(\(.+\))?(!)?: .{1,72}$'

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo "Invalid commit message: \"$commit_msg\""
  echo ""
  echo "Must match: <type>[optional scope]: <description>"
  echo "  Types: feat, fix, docs, style, refactor, perf, test, chore, build, ci, revert"
  echo "  Examples:"
  echo "    feat: add heatmap view"
  echo "    fix(ui): correct border color"
  echo "    chore!: drop support for old config format"
  exit 1
fi
